# Copy to backend/.env (git-ignored) and fill in your own values. Never commit .env.
# Names only here: no real values.

# LLM gateway (app/common/llm.py). Leave empty to use the template fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# If Gemini answers HTTP 429 (free quota used), try GEMINI_MODEL=gemini-2.5-flash-lite (separate quota)
# Groq models change: list yours with GET https://api.groq.com/openai/v1/models. Backup: openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_S=15

# API (app/main.py)
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# AUDIT_DB=data/audit/audit.db

# Doc search (app/common/doc_search.py)
# DOCS_DIR=data/docs
# DOC_SEARCH_DENSE=1
# DOC_SEARCH_RRF_K=60
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# Database (app/db/engine.py). Empty = local SQLite file data/app.db. On Render: the Neon URL (sslmode=require).
DATABASE_URL=
# Login (app/auth/). Long random string; never reuse a real password.
JWT_SECRET=
# JWT_EXPIRE_HOURS=8
# Demo users for scripts/seed_users.py: username:password:role separated by commas
# role = employee (submits complaints), analyst (console) or lead (console + stats)
DEMO_USERS=
