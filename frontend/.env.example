# Copy to .env.local (git-ignored) to change where the frontend finds the FastAPI backend.
# No secrets belong here: every VITE_* value is visible in the browser.

# Leave empty in development: the Vite dev server proxies /api and /health to VITE_PROXY_TARGET.
# Set it for a deployed build, e.g. VITE_API_BASE_URL=https://api.example.internal
VITE_API_BASE_URL=

# Where the dev proxy sends requests (default http://127.0.0.1:8000).
VITE_PROXY_TARGET=http://127.0.0.1:8000
